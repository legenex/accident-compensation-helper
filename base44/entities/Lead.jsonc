{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "accident_type": {
      "type": "string",
      "enum": [
        "Auto Accident",
        "Commercial Accident",
        "Rideshare Accident",
        "Workplace Accident",
        "Slip and Fall",
        "Medical Malpractice",
        "Other"
      ]
    },
    "state": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "In Review",
        "Qualified",
        "Contacted",
        "Disqualified",
        "Closed"
      ],
      "default": "New"
    },
    "estimate_low": {
      "type": "number"
    },
    "estimate_high": {
      "type": "number"
    },
    "qualification_tier": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3",
        "DQ"
      ]
    },
    "assigned_attorney_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_initials": {
      "type": "string"
    },
    "author_location": {
      "type": "string"
    },
    "time_ago": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "author_name",
    "quote"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "VerifiedMetric",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "evidence_note": {
      "type": "string"
    },
    "reporting_period": {
      "type": "string"
    },
    "last_verified_date": {
      "type": "string",
      "format": "date"
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "label",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_approved": true
            },
            {
              "data.is_public": true
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}